{
  "name": "my-website-2026",
  "version": "0.1.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dailephd/my-website-2026.git"
  },
  "scripts": {
    "install:all": "npm install",
    "docker:ready": "powershell -ExecutionPolicy Bypass -File scripts/Start-DockerDesktop.ps1",
    "dev:check": "powershell -ExecutionPolicy Bypass -File scripts/Check-DevEnv.ps1",
    "dev:web": "next dev",
    "dev": "npm run dev:check && powershell -ExecutionPolicy Bypass -File scripts/Start-Dev.ps1",
    "dev:docker": "npm run docker:ready && docker compose up --build -d",
    "dev:docker:down": "npm run docker:ready && docker compose down --remove-orphans",
    "build": "next build",
    "start": "next start",
    "lint": "node scripts/lint.mjs",
    "lint:next": "next lint",
    "typecheck": "next typegen && tsc --noEmit",
    "validate:content": "node scripts/validate-content.mjs",
    "validate:links": "node scripts/validate-links.mjs",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test": "npm run test:unit",
    "test:all": "npm run typecheck && npm run lint && npm run validate:content && npm run validate:links && npm run test:unit",
    "check:release": "node scripts/check-release-readiness.mjs",
    "sync:publications": "node scripts/sync-publications.mjs",
    "generate:favicons": "node scripts/generate-favicons.mjs",
    "test:contact-email": "node scripts/send-contact-test.mjs",
    "ci": "npm run typecheck && npm run lint && npm run validate:content && npm run validate:links && npm run test && npm run build"
  },
  "dependencies": {
    "next": "^15.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.16.0"
  },
  "devDependencies": {
    "@playwright/test": "1.54.2",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "^16.3.2",
    "@types/node": "20.17.57",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "^15.5.0",
    "eslint-config-prettier": "^9.1.0",
    "jsdom": "^29.1.1",
    "postcss": "8.4.49",
    "prettier": "3.4.2",
    "tailwindcss": "3.4.16",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.5"
  }
}
