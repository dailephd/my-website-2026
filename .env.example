# Production site URL — used for canonical URLs, Open Graph, sitemap, and robots.
# Set this in Vercel environment variables before deployment.
# Local fallback: http://localhost:3000 (used when this variable is absent or empty).
NEXT_PUBLIC_SITE_URL=https://example.com

# Optional: set to "true" to disallow all crawlers in robots.txt output.
# Leave unset or set to "false" for normal production behavior.
# Useful for preview/staging environments to prevent search indexing.
NEXT_PUBLIC_NOINDEX=false

# Optional: ORCID iD for fetching public works via scripts/sync-publications.mjs.
# Format: 0000-0000-0000-0000
# Leave unset to skip ORCID fetch during sync.
PUBLICATIONS_ORCID_ID=

# ── Contact form email (Resend) ───────────────────────────────────────────────
# Required for the /api/contact route to send email.
# Sign up at https://resend.com and obtain an API key.
# Never prefix this with NEXT_PUBLIC_ — it must stay server-side only.
RESEND_API_KEY=

# Destination address for contact form submissions.
# Defaults to dailephd@gmail.com if not set, but prefer setting it explicitly.
CONTACT_TO_EMAIL=example@example.com

# Verified sender address in your Resend account (required).
# Must belong to a domain you have verified in Resend.
# Do NOT use the visitor's email here — that would likely trigger spam filters.
CONTACT_FROM_EMAIL=contact@example.com

# Display name shown in the From field of outgoing messages.
CONTACT_FROM_NAME=

# Prefix added to the email subject line for easy filtering in Gmail.
CONTACT_SUBJECT_PREFIX=[contact]

# Set to "true" only when you want to send a real test email via:
#   npm run test:contact-email
# Leave as "false" during normal development, testing, and CI.
ALLOW_REAL_CONTACT_EMAIL_TEST=false
